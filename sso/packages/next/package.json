{
  "name": "@inon-ai/inon-sso",
  "version": "0.1.0",
  "description": "Server-side OAuth and project-session integration for iNon applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacksonHe04/iNon.git",
    "directory": "sso/packages/next"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "6.2.4"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
